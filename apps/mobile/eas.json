{
  "cli": {
    "version": ">= 9.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://euro-store.netlify.app",
        "EXPO_PUBLIC_ADMIN_URL": "https://euro-store-admin.netlify.app",
        "EXPO_PUBLIC_HELPER_URL": "https://euro-store-helper.netlify.app",
        "EXPO_PUBLIC_PARTNER_URL": "https://euro-store-partner.netlify.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://euro-store.netlify.app",
        "EXPO_PUBLIC_ADMIN_URL": "https://euro-store-admin.netlify.app",
        "EXPO_PUBLIC_HELPER_URL": "https://euro-store-helper.netlify.app",
        "EXPO_PUBLIC_PARTNER_URL": "https://euro-store-partner.netlify.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
